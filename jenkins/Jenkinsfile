pipeline{

    agent {
        label 'Node1'
    }

    stages{
      stage('build'){
        steps{
          sh '''
              echo "Build stage completed"
          '''
        }
      }
      stage('deploy'){
          steps{
              sh '''
                echo "Running Python script"
                python3 ${WORKSPACE}/python/script.py
              '''
          }
      }
    }
}
