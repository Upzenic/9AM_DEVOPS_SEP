pipeline {
    agent any

    stages {
        stage('Check Python') {
            steps {
                sh 'python3 --version'
            }
        }

        stage('Run Website Health Check') {
            steps {
                sh '''
                    python3 -m venv .venv
                    .venv/bin/python -m pip install requests
                    .venv/bin/python python/website_health.py
                '''
            }
        }
    }
}
